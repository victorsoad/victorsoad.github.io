---
import { SITE } from '../site';
const ano = new Date().getFullYear();
---
<footer>
  <div class="largo">
    <hr class="traco" />
    <div class="grade">
      <p class="rotulo">[ Contato ]</p>
      <ul class="grandes">
        <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
        <li><a href={SITE.github} rel="me noopener" target="_blank">GitHub</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
    <div class="base rotulo">
      <span>Victor Soares · Engenharia de software · IA aplicada</span>
      <span>© {ano} · Opiniões pessoais</span>
    </div>
  </div>
</footer>

<style>
  footer { margin-top: 7rem; }
  .grade { display: grid; gap: 1rem; padding: 2.5rem 0 3rem; }
  @media (min-width: 720px) { .grade { grid-template-columns: 1fr 1fr; } }
  .grade .rotulo { margin: 0; }
  .grandes { list-style: none; margin: 0; padding: 0; }
  .grandes a {
    font-family: var(--display); font-weight: 800; text-transform: uppercase; text-decoration: none;
    font-size: clamp(2.4rem, 7vw, 4rem); line-height: 0.95; letter-spacing: -0.035em;
  }
  .grandes a:hover { box-shadow: inset 0 -0.38em 0 var(--acento); }
  .base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem;
    border-top: 1px solid var(--linha); padding: 1.1rem 0 2rem;
  }
</style>
