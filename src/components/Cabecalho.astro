---
const atual = Astro.url.pathname;
const links = [
  { href: '/', rotulo: 'Artigos' },
  { href: '/categorias/', rotulo: 'Categorias' },
  { href: '/sobre/', rotulo: 'Sobre' },
];
const ativo = (href: string) => (href === '/' ? atual === '/' || atual.startsWith('/posts') : atual.startsWith(href));
---
<header class="topo">
  <div class="largo linha">
    <a href="/" class="marca" aria-label="Victor Soares, página inicial">
      <span class="quadro" aria-hidden="true"></span>Victor Soares
    </a>
    <nav aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} aria-current={ativo(l.href) ? 'page' : undefined}>{l.rotulo}</a>
      ))}
      <a class="contato" href="https://www.linkedin.com/in/victorsoad" target="_blank" rel="me noopener">LinkedIn ↗</a>
    </nav>
  </div>
</header>

<style>
  .linha {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding-top: 1.1rem; padding-bottom: 1.1rem;
  }
  .marca {
    display: inline-flex; align-items: center; gap: 0.55rem;
    font-family: var(--mono); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; text-decoration: none; white-space: nowrap;
  }
  .quadro { width: 0.7rem; height: 0.7rem; background: var(--acento); outline: 1px solid var(--tinta); outline-offset: 2px; }
  nav { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }
  nav a {
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; color: var(--cinza);
  }
  nav a:hover, nav a[aria-current='page'] { color: var(--tinta); }
  nav a[aria-current='page'] { box-shadow: inset 0 -0.5em 0 var(--acento); }
  .contato { color: var(--tinta); border: 1px solid var(--tinta); padding: 0.3rem 0.6rem; }
  .contato:hover { background: var(--tinta); color: var(--papel) !important; }
  @media (max-width: 520px) { .contato { display: none; } nav { gap: 1.1rem; } }
</style>
