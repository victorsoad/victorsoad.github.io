---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { SITE } from '../site';

interface Props {
  titulo?: string;
  descricao?: string;
  tipo?: 'website' | 'article';
  publicado?: Date;
}
const { titulo, descricao = SITE.descricao, tipo = 'website', publicado } = Astro.props;
const tituloPagina = titulo ? `${titulo} | ${SITE.nome}` : SITE.titulo;
const canonica = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.titulo} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content="Victor Soares" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo ?? SITE.titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#FAFAF8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter+Tight:wght@500;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <Cabecalho />
    <main><slot /></main>
    <Rodape />
  </body>
</html>
