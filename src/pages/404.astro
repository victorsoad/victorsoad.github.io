---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada">
  <section class="largo" style="padding-top:5rem">
    <p class="rotulo">[ Erro 404 ]</p>
    <h1 style="font-family:var(--display);font-weight:800;text-transform:uppercase;font-size:clamp(2.4rem,7vw,5rem);line-height:.92;letter-spacing:-.045em;margin:.6rem 0 2rem">Essa página não existe.</h1>
    <p><a class="rotulo" href="/" style="color:var(--tinta)">← Voltar para os artigos</a></p>
  </section>
</Base>
